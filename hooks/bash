# whyexit hook for bash. Load it with: eval "$(whyexit init bash)"

_whyexit_hook() {
  local code=$? cmd
  if [[ $_whyexit_ran == 1 ]]; then
    case $code in
      0{{range .Skip}}|{{.}}{{end}}) ;;
      *)
        cmd=$(HISTTIMEFORMAT= builtin history 1)
        # Drop the history number in front of the command.
        cmd=${cmd#"${cmd%%[![:space:][:digit:]]*}"}
        command whyexit hint "$code" "$cmd"
        ;;
    esac
  fi
  _whyexit_ran=$_whyexit_idle
  return $code
}

# PS0 (bash 4.4+) flags that a command ran, so Enter on an empty line
# does not repeat the last hint. Older bash checks at every prompt.
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
  _whyexit_idle=0
  _whyexit_mark=("")
  [[ ${PS0-} == *_whyexit_mark* ]] || PS0='${_whyexit_mark[_whyexit_ran=1,0]}'${PS0-}
else
  _whyexit_idle=1
fi
_whyexit_ran=0

# Run first, so the status is read before other prompt commands change it.
[[ ${PROMPT_COMMAND-} == _whyexit_hook* ]] ||
  PROMPT_COMMAND="_whyexit_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
